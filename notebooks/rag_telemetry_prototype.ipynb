    "\"\"\"\n",
    "\n",
    "# 4. RAG Evaluation Harness (Ragas Integration)\n",
    "def run_eval(eval_dataset_dict):\n",
    "    dataset = Dataset.from_dict(eval_dataset_dict)\n",
    "    results = evaluate(\n",
    "        dataset=dataset,\n",
    "        metrics=[faithfulness, context_precision, answer_relevance]\n",
