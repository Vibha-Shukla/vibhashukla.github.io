    "# 3. Prompting with Strict Grounding Guardrails\n",
    "SYSTEM_PROMPT = \"\"\"You are an Enterprise Equipment Diagnostic AI.\n",
    "Answer the question based ONLY on the following context. If you cannot answer using the context, state 'INSUFFICIENT_OEM_DATA'.\n",
    "\n",
    "Context:\n",
    "{context}\n",
