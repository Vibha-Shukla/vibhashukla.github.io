# 5. RAG Evaluation Harness (Ragas Integration)
def run_eval(eval_dataset_dict):
    dataset = Dataset.from_dict(eval_dataset_dict)
    results = evaluate(
        dataset=dataset,
        metrics=[faithfulness, context_precision, answer_relevance]
    )
    return results.to_pandas()
